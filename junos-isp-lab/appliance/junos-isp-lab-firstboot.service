[Unit]
Description=Junos ISP Lab - configuración del primer arranque (Docker, Containerlab, app)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/junos-isp-lab/firstboot.done

[Service]
Type=oneshot
ExecStart=/opt/junos-isp-lab/appliance/firstboot.sh
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
