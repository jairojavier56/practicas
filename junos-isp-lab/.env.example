# Copia a .env y ajusta.
PORT=8080
# mock = sin imágenes (CLI simulado, ideal para desarrollar la UI)
# containerlab = despliegue real con tus imágenes Juniper
DRIVER=mock
# Ruta al catálogo de imágenes (NO se hardcodea en el código)
IMAGES_CONFIG=./config/images.yaml
# Directorio de trabajo donde se generan topologías clab y configs
DATA_DIR=./data
# Directorio de laboratorios guiados
LABS_DIR=./labs
# Binario de containerlab (suele requerir root o sudo sin password)
CLAB_BIN=containerlab
CLAB_SUDO=true
# Credenciales para nodos VM (vJunos/vMX/vSRX) que se usan por SSH.
# Se inyectan como variables de entorno al proceso hijo, nunca en el código.
JUNOS_USER=admin
JUNOS_PASSWORD=admin@123
# Límite de recursos del host (el backend rechaza el deploy si se supera)
HOST_RAM_BUDGET_MB=28000
HOST_VCPU_BUDGET=16
