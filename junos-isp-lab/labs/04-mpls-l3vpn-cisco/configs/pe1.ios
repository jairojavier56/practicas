! ===== pe1 (Cisco IOL, AS65000) — generado por generate.py =====
hostname pe1
ip bgp-community new-format
vrf definition CUST-A
 rd 65000:10011
 address-family ipv4
  route-target export 65000:100
  route-target import 65000:100
 exit-address-family
interface Loopback0
 ip address 10.255.0.11 255.255.255.255
 ip router isis CORE
interface Ethernet0/1
 description -> p1
 ip address 10.1.2.1 255.255.255.252
 ip router isis CORE
 isis network point-to-point
 mpls ip
 no shutdown
interface Ethernet0/2
 description -> p2
 ip address 10.1.3.1 255.255.255.252
 ip router isis CORE
 isis network point-to-point
 mpls ip
 no shutdown
interface Ethernet0/3
 description -> ce-a1
 vrf forwarding CUST-A
 ip address 172.16.1.1 255.255.255.252
 no shutdown
router isis CORE
 net 49.0001.0102.5500.0011.00
 is-type level-2-only
 metric-style wide
 passive-interface Loopback0
mpls label protocol ldp
mpls ldp router-id Loopback0 force
router bgp 65000
 bgp router-id 10.255.0.11
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 10.255.0.100 remote-as 65000
 neighbor 10.255.0.100 update-source Loopback0
 address-family ipv4
  neighbor 10.255.0.100 activate
  neighbor 10.255.0.100 next-hop-self
  neighbor 10.255.0.100 send-community both
 exit-address-family
 address-family vpnv4
  neighbor 10.255.0.100 activate
  neighbor 10.255.0.100 send-community extended
 exit-address-family
 address-family ipv4 vrf CUST-A
  neighbor 172.16.1.2 remote-as 65501
  neighbor 172.16.1.2 activate
 exit-address-family
end
