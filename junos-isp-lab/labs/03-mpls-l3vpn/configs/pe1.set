# ===== pe1 (Juniper cRPD, AS65000) =====
# VERIFICAR en tu versión de cRPD: las interfaces son las de Linux (ethX).
set interfaces eth1 description "-> p1"
set interfaces eth1 unit 0 family inet address 10.1.2.1/30
set interfaces eth1 unit 0 family iso
set interfaces eth1 unit 0 family mpls
set interfaces eth2 description "-> p2"
set interfaces eth2 unit 0 family inet address 10.1.3.1/30
set interfaces eth2 unit 0 family iso
set interfaces eth2 unit 0 family mpls
set interfaces eth3 description "-> ce-a1"
set interfaces eth3 unit 0 family inet address 172.16.1.1/30
set interfaces lo0 unit 0 family inet address 10.255.0.11/32
set interfaces lo0 unit 0 family iso address 49.0001.0102.5500.0011.00
set routing-options router-id 10.255.0.11
set routing-options autonomous-system 65000
set protocols isis level 1 disable
set protocols isis level 2 wide-metrics-only
set protocols isis interface lo0.0 passive
set protocols isis interface eth1 point-to-point
set protocols isis interface eth2 point-to-point
set protocols mpls interface eth1
set protocols ldp interface eth1
set protocols mpls interface eth2
set protocols ldp interface eth2
set protocols bgp group RR type internal
set protocols bgp group RR local-address 10.255.0.11
set protocols bgp group RR family inet unicast
set protocols bgp group RR family inet-vpn unicast
set protocols bgp group RR neighbor 10.255.0.100
set routing-instances CUST-A instance-type vrf
set routing-instances CUST-A interface eth3
set routing-instances CUST-A route-distinguisher 65000:10011
set routing-instances CUST-A vrf-target target:65000:100
set routing-instances CUST-A vrf-table-label
set routing-instances CUST-A protocols bgp group CE type external
set routing-instances CUST-A protocols bgp group CE peer-as 65501
set routing-instances CUST-A protocols bgp group CE neighbor 172.16.1.2
